{
  "name": "iron-legion-mcp",
  "version": "1.0.0",
  "description": "Local-first software factory with persistent autonomous workers and an interactive MCP App.",
  "private": true,
  "type": "module",
  "main": "dist/servers/orchestrator/index.js",
  "scripts": {
    "start": "node dist/servers/orchestrator/index.js",
    "dashboard": "node dist/servers/orchestrator/index.js --dashboard",
    "dev": "tsx servers/orchestrator/index.ts --dashboard",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && vite build && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p app/tsconfig.json",
    "smoke:transport": "node scripts/smoke-transport.mjs",
    "smoke:workflow": "tsx scripts/smoke-workflow.ts",
    "test:ui": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke:transport && npm run smoke:workflow && npm run test:ui && npm audit",
    "prepack": "npm run build",
    "smoke:live": "tsx scripts/smoke-workflow.ts --live"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlite-vec": "^0.1.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "rollup": "^4.59.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "iron-legion": "dist/servers/orchestrator/index.js"
  },
  "files": [
    "dist",
    "sample-repo",
    "config.example.json",
    "README.md",
    "setup.md",
    "userguide.md",
    "assets/social/iron-legion-banner.png",
    "scripts/codex-worker.mjs",
    "docs"
  ],
  "license": "UNLICENSED"
}
